# ─── Portfolio API ───────────────────────────────────────────────
PORT=4000
# Comma-separated origins allowed to call this API (the React app).
CORS_ORIGINS=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────
# SQLite for local dev (zero setup). For production, switch the
# datasource provider in prisma/schema.prisma to "postgresql" and
# point this at your Postgres instance:
#   DATABASE_URL="postgresql://user:pass@host:5432/portfolio?schema=public"
DATABASE_URL="file:./dev.db"

# ─── SimpleFlow AI Orchestrator (optional) ───────────────────────
# When set, POST /api/ai/plan proxies to SimpleFlow's
# /ai-orchestration/chat with dryRun=true (plans, never mutates).
# When unset, the API uses a built-in heuristic planner instead, so
# the demo always works. The token NEVER reaches the browser.
SIMPLEFLOW_URL=
# Provide EITHER a ready token…
SIMPLEFLOW_TOKEN=
# …OR demo credentials the API logs in with at startup.
SIMPLEFLOW_EMAIL=
SIMPLEFLOW_PASSWORD=
# userId passed as context to the orchestrator (its planner expects one).
SIMPLEFLOW_USER_ID=1
